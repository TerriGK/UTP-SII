<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de Grupos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root {
      --primary-color: #911820;
      --primary-hover: #7a141a;
      --secondary-color: #f8f9fa;
      --dark-text: #2c3e50;
      --medium-text: #495057;
      --light-text: #6c757d;
      --border-color: #e9ecef;
      --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      --card-shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.12);
      --transition: all 0.3s ease;
    }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background-color: var(--secondary-color);
      color: var(--dark-text);
      line-height: 1.6;
    }

    /* Preloader */
    #preloader {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(255, 255, 255, 0.9);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      backdrop-filter: blur(3px);
    }

    /* Contenedor principal */
    .container {
      max-width: 1400px;
      padding: 2rem 1rem;
    }

    /* Card principal - MANTENIENDO ESTRUCTURA ORIGINAL */
    .card {
      border: none;
      border-radius: 12px;
      box-shadow: var(--card-shadow);
      overflow: hidden;
      transition: var(--transition);
      margin-bottom: 2rem;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: var(--card-shadow-hover);
    }

    .card-header {
      background-color: white;
      padding: 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }

    .card-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--dark-text);
      margin: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    /* Botones - MANTENIENDO CLASES ORIGINALES */
    .btn-custom {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 500;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      height: 36px;
    }

    .btn-custom:hover {
      background-color: var(--primary-hover);
      transform: translateY(-2px);
    }

    .btn-main-action {
      padding: 8px 16px;
      font-size: 14px;
    }

    /* Tabla - MANTENIENDO ESTRUCTURA ORIGINAL */
    .table-responsive {
      border-radius: 8px;
      overflow: hidden;
      margin: 1.5rem;
      border: 1px solid var(--border-color);
    }

    .table {
      width: 100%;
      margin-bottom: 0;
      font-size: 0.9rem;
    }

    .table-custom {
      background-color: var(--primary-color);
      color: white;
    }

    .table-custom th {
      padding: 1rem;
      font-weight: 500;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 0.5px;
      text-align: center;
      border: none;
    }

    .table tbody tr {
      transition: var(--transition);
    }

    .table tbody tr:nth-child(even) {
      background-color: var(--secondary-color);
    }

    .table tbody tr:hover {
      background-color: rgba(145, 24, 32, 0.05);
    }

    .table td {
      padding: 1rem;
      vertical-align: middle;
      border-top: 1px solid var(--border-color);
      color: var(--medium-text);
    }

    /* Paginación - MANTENIENDO ESTRUCTURA ORIGINAL */
    .pagination-buttons {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
    }

    /* Spinner - MANTENIENDO ID ORIGINAL */
    #load {
      width: 2.5rem;
      height: 2.5rem;
      border-width: 0.25em;
      color: var(--primary-color);
    }

    /* Responsive */
    @media (max-width: 992px) {
      .table-responsive {
        overflow-x: auto;
      }
      
      .table {
        min-width: 1000px;
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 1rem;
      }
      
      .card-title {
        flex-direction: column;
        align-items: flex-start;
      }
      
      .pagination-buttons {
        flex-direction: column;
        gap: 0.75rem;
      }
    }
  </style>
</head>
<body>
  <section class="container py-4">
    <!-- Botón de volver - MANTENIENDO ESTRUCTURA ORIGINAL -->
    <div class="mb-3">
      {{>btnBack}}
    </div>

    <!-- Contenedor principal - MANTENIENDO ID ORIGINAL -->
    <div id="container" class="d-none">
      <div class="col-lg-12">
        <div class="card">
          <div class="card-header">
            <h1 class="card-title">
              <div>
                <h1 class="bi bi-people-fill">Lista de Grupos</h1>
              </div>
              <!-- Enlace original mantenido -->
              <a class="btn btn-custom btn-main-action" href="/grupos/crear">
                <i class="bi bi-plus-circle"></i> Nuevo Grupo
              </a>
            </h1>
          </div>

          <!-- Tabla - MANTENIENDO IDS ORIGINALES -->
          <div id="buscar" class="table-responsive">
            <table class="table">
              <thead class="table-custom">
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Código carrera</th>
                  <th scope="col">Inicio</th>
                  <th scope="col">Final</th>
                  <th scope="col">Código grupo</th>
                  <th scope="col">Cuatrimestre</th>
                  <th scope="col">Grupo</th>
                  <th scope="col">Inscritos</th>
                  <th scope="col">Tutor</th>
                </tr>
              </thead>

              <tbody id="table-container">
                <!-- Datos se cargarán aquí -->
              </tbody>
            </table>

            <div class="d-flex justify-content-center">
              <div class="spinner-border" role="status" id="load" style="display: none;"></div>
            </div>
          </div>

          <!-- Paginación - MANTENIENDO ESTRUCTURA ORIGINAL -->
          <div class="pagination-buttons">
            <button onclick="prev()" class="btn btn-custom" id="prev-btn" disabled>
              <i class="bi bi-arrow-left"></i> Anterior
            </button>
            <span class="d-flex align-items-center px-2 text-muted" id="page-info" style="font-size: 13px;">
              Página 1 de 1
            </span>
            <button onclick="next()" class="btn btn-custom" id="next-btn" disabled>
              Siguiente <i class="bi bi-arrow-right"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Preloader - MANTENIENDO ID ORIGINAL -->
    <div id="preloader">
      <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando...</span>
      </div>
      <div class="mt-2 text-primary" style="font-size: 14px; font-weight: 500;">
        Cargando lista de grupos...
      </div>
    </div>
  </section>

  <!-- Script original mantenido -->
  <script src="/js/services/admin/getGruposCalifi.js"></script>
</body>
</html>