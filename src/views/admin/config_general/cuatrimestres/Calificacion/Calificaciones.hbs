<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seleccionar Ciclo</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/ciclo.css">
</head>

<body>
  <div class="container">
    <h1 class="my-4">Seleccionar Ciclo</h1>

    <!-- Notificación de Estado -->
    <div id="notification" class="notification"></div>

    <div class="content-container">
      <!-- Ciclos activos (izquierda) -->
      <div id="activeCycles" class="active-cycles">
        <div class="section-title">
          <h4><i class="fas fa-calendar-alt"></i> Ciclos Disponibles <span id="activeCount" class="badge-count">0</span></h4>
          <button id="selectAllActive" class="btn btn-sm btn-outline-primary">
            <i class="fas fa-check-square"></i> Seleccionar Todos
          </button>
        </div>
        <div id="emptyActiveCycles" class="no-cycles-message" style="display: none;">
          <i class="fas fa-exclamation-circle"></i> No hay ciclos disponibles
        </div>
        <ul class="list-group" id="cicloList">
          <!-- Los ciclos serán cargados dinámicamente aquí -->
        </ul>
      </div>

      <!-- Ciclos ocultos (derecha) -->
      <div id="hiddenCycles" class="hidden-cycles">
        <div class="section-title">
          <h4><i class="fas fa-eye-slash"></i> Ciclos Ocultos <span id="hiddenCount" class="badge-count">0</span></h4>
          <button id="restoreAllHidden" class="btn btn-sm btn-outline-success">
            <i class="fas fa-sync-alt"></i> Restaurar Todos
          </button>
        </div>
        <div id="emptyHiddenCycles" class="no-cycles-message" style="display: none;">
          <i class="fas fa-check-circle"></i> No hay ciclos ocultos
        </div>
        <ul class="list-group" id="hiddenCyclesList">
          <!-- Los ciclos ocultos se mostrarán aquí -->
        </ul>
      </div>
    </div>
  </div>

  <!-- Cargar JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    "use strict";

    // Elementos del DOM
    const elements = {
      cicloList: document.getElementById("cicloList"),
      hiddenCyclesList: document.getElementById("hiddenCyclesList"),
      notification: document.getElementById("notification"),
      activeCountBadge: document.getElementById("activeCount"),
      hiddenCountBadge: document.getElementById("hiddenCount")
    };

    // Arrays de ciclos
    let allCycles = [];
    let hiddenCycleIds = JSON.parse(localStorage.getItem("hiddenCycles") || "[]");

    // Notificación
    const notify = (message, type) => {
      const { notification } = elements;
      notification.textContent = message;
      notification.className = `notification ${type} show`;
      setTimeout(() => notification.className = "notification", 3000);
    };

    // Crear botones de acción
    const createButton = (iconClass, text, btnClass, onClick) => {
      const button = document.createElement("button");
      button.className = `btn btn-sm btn-toggle ${btnClass}`;
      button.innerHTML = `<i class="${iconClass}"></i> ${text}`;
      button.addEventListener("click", onClick);
      return button;
    };

    // Crear elemento de ciclo
    const createCycleElement = (cycle, isHidden) => {
      const { CODIGO_CORTO, DESCRIPCION, INICIAL, FINAL, PERIODO } = cycle;

      const listItem = document.createElement("li");
      listItem.className = "list-group-item cycle-card";
      listItem.dataset.id = CODIGO_CORTO;

      const header = document.createElement("div");
      header.className = "cycle-header";

      const titulo = document.createElement("h5");
      titulo.textContent = `${DESCRIPCION} (${CODIGO_CORTO})`;

      const actions = document.createElement("div");
      actions.className = "cycle-actions";

      const button = isHidden
        ? createButton("fas fa-eye", "Mostrar", "btn-restore", () => restoreCycle(CODIGO_CORTO))
        : createButton("fas fa-eye-slash", "Ocultar", "btn-hide", () => hideCycle(CODIGO_CORTO));

      actions.appendChild(button);
      header.append(titulo, actions);

      const detailsList = document.createElement("ul");
      detailsList.className = "cycle-list";
      detailsList.innerHTML = `
        <li><strong>Inicial:</strong> ${INICIAL}</li>
        <li><strong>Final:</strong> ${FINAL}</li>
        <li><strong>Periodo:</strong> ${PERIODO}</li>
      `;

      listItem.append(header, detailsList);
      return listItem;
    };

    // Ocultar ciclo
    const hideCycle = (id) => {
      const cycle = allCycles.find(c => c.CODIGO_CORTO === id);
      if (!cycle) return;

      if (!hiddenCycleIds.includes(id)) {
        hiddenCycleIds.push(id);
        localStorage.setItem("hiddenCycles", JSON.stringify(hiddenCycleIds));
      }

      document.querySelector(`#cicloList li[data-id="${id}"]`)?.remove();
      elements.hiddenCyclesList.appendChild(createCycleElement(cycle, true));
      updateCounters();
      notify(`Ciclo ${id} ocultado`, "success");
    };

    // Restaurar ciclo
    const restoreCycle = (id) => {
      const cycle = allCycles.find(c => c.CODIGO_CORTO === id);
      if (!cycle) return;

      hiddenCycleIds = hiddenCycleIds.filter(cycleId => cycleId !== id);
      localStorage.setItem("hiddenCycles", JSON.stringify(hiddenCycleIds));

      document.querySelector(`#hiddenCyclesList li[data-id="${id}"]`)?.remove();
      elements.cicloList.appendChild(createCycleElement(cycle, false));
      updateCounters();
      notify(`Ciclo ${id} restaurado`, "success");
    };

    // Actualizar contadores
    const updateCounters = () => {
      elements.activeCountBadge.textContent = elements.cicloList.querySelectorAll('li').length;
      elements.hiddenCountBadge.textContent = elements.hiddenCyclesList.querySelectorAll('li').length;
    };

    // Cargar ciclos
    const cargarCiclosLista = async () => {
      try {
        const response = await fetch("/api/cuatris-navbar");
        if (!response.ok) throw new Error(`Error al obtener ciclos: ${response.status}`);
        const { ciclos = [] } = await response.json();

        // Filtrar ciclos con PERIODO > 0
        allCycles = ciclos
          .filter(cycle => cycle.PERIODO > 0)
          // Ordenar por CODIGO_CORTO descendente (2025 a 2012)
          .sort((a, b) => b.CODIGO_CORTO.localeCompare(a.CODIGO_CORTO));

        elements.cicloList.innerHTML = "";
        elements.hiddenCyclesList.innerHTML = "";

        allCycles.forEach(cycle => {
          const isHidden = hiddenCycleIds.includes(cycle.CODIGO_CORTO);
          const cycleElement = createCycleElement(cycle, isHidden);
          (isHidden ? elements.hiddenCyclesList : elements.cicloList).appendChild(cycleElement);
        });

        updateCounters();
      } catch (error) {
        console.error("Error al cargar los ciclos:", error);
        notify("No se pudieron cargar los ciclos. Intente nuevamente más tarde.", "error");
      }
    };

    // Inicializar
    cargarCiclosLista();
  </script>
</body>

</html>
