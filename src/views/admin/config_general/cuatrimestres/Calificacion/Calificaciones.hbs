<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gestión de Ciclos Académicos</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link rel="stylesheet" href="/css/ciclo.css">

</head>

<body>
  <div class="container">
    <h1><i class="fas fa-calendar-alt"></i> Gestión de Ciclos Académicos</h1>

    <div class="cycles-container">
      <div class="cycles-column">
        <div class="column-title">Ciclos Disponibles</div>
        <ul class="cycles-list" id="activeCyclesList">
          <div class="loading">
            <i class="fas fa-spinner fa-spin"></i> Cargando ciclos...
          </div>
        </ul>
      </div>
      <div class="cycles-column">
        <div class="column-title">Ciclos Ocultos</div>
        <ul class="cycles-list" id="hiddenCyclesList">
          <div class="no-cycles">
            <i class="fas fa-eye-slash"></i> No hay ciclos ocultos
          </div>
        </ul>
      </div>
    </div>
  </div>

  <div id="notification" class="notification"></div>
  <script src="/js/services/admin/getciclos.js"></script>
</body>

</html>
