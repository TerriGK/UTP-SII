<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Verificación de la CURP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css">

  <style>
    body, html {
      height: 100%;
      margin: 0;
      background-color: #a4273d;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
    }

    .layout-wrapper {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .top-button {
      padding-left: 5%;
      margin-bottom: 20px;
    }

    .btn-regresar {
      background-color: #d4edda;
      color: #155724;
      font-weight: bold;
      border: 1px solid #c3e6cb;
      border-radius: 10px;
      padding: 8px 20px;
    }

    .center-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      overflow-x: auto;
      padding-left: 10%;
      padding-right: 10%;
    }

    .card-container {
      min-width: 100%;
      display: flex;
      justify-content: flex-start;
    }

    .card {
      border: none;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      width: 100%;
      max-width: 500px;
      background-color: #fff;
    }

    .card-header {
      color: #a4273d;
      font-size: 1.4rem;
      font-weight: bold;
      text-align: center;
      border-top-left-radius: 15px;
      border-top-right-radius: 15px;
    }

    .form-control {
      border-radius: 10px;
    }

    .invalid-input {
      border: 2px solid red;
    }

    .error-message {
      color: red;
      display: none;
      font-size: 0.9rem;
    }

    .custom-link {
      display: inline-block;
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .info-alert {
      font-size: 0.85rem;
      margin-top: 20px;
      background-color: #f8f9fa;
      border-left: 5px solid #a4273d;
    }
  </style>
</head>
<body>

  <div class="layout-wrapper">
    <!-- Botón Regresar -->
    <div class="top-button">
      <a href="auth/nuevos.hbs" class="btn btn-regresar">&larr; Regresar</a>
    </div>

    <!-- Card desplazable -->
    <div class="center-wrapper">
      <div class="card-container">
        <div class="card">
          <div class="card-header">
            Verificación de la CURP
          </div>
          <div class="card-body p-4">
            <form id="myForm" action="/clave" method="GET" novalidate>
              <div class="form-group">
                <label for="curp">Introduce tu CURP:</label>
                <input type="text" id="curp_" name="CLAVE_CIUDADANA" class="form-control strong-text" required placeholder="Ej. GODE561231HDFRRN04">
                <div id="curpErrorMessage" class="error-message">CURP inválida</div>
              </div>

              <button type="submit" class="btn btn-primary btn-block">Verificar</button>

              <a target="_blank" href="https://www.gob.mx/curp/" class="custom-link text-primary">Consultar CURP en gob.mx</a><br>
            </form>

            <div class="alert info-alert mt-4" role="alert">
              El CURP proporcionado será utilizado como identificador único para verificar tu existencia en el sistema de la Universidad Tecnológica del Poniente (UTP). Consulta el 
              <a href="https://controlescolarutp.wixsite.com/utp-yucatan/aviso-de-privacidad" target="_blank" class="alert-link">Aviso de Privacidad</a>.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"></script>

  <script>
    function validaCurp() {
      const inputCurp = document.getElementById("curp_");
      const curpValue = inputCurp.value.trim().toUpperCase().replace(/\s+/g, "");

      const re = /^[A-Z]{4}\d{6}[HM][A-Z]{5}[A-Z0-9]{2}$/;
      const validado = curpValue.match(re);

      if (!validado) {
        inputCurp.classList.add("invalid-input");
        document.getElementById("curpErrorMessage").style.display = "block";
        setTimeout(() => {
          inputCurp.classList.remove("invalid-input");
          document.getElementById("curpErrorMessage").style.display = "none";
        }, 1000);
        return false;
      }
      return true;
    }

    document.getElementById("myForm").addEventListener("submit", function(event) {
      if (!validaCurp()) {
        event.preventDefault();
      }
    });

    document.getElementById("curp_").addEventListener("input", function() {
      this.value = this.value.trim().toUpperCase().replace(/\s+/g, "");
    });

    document.addEventListener("keydown", function(event) {
      if (event.ctrlKey && event.key === "z") {
        event.preventDefault();
        document.getElementById("curp_").value = "";
      }
    });
  </script>

</body>
</html>
