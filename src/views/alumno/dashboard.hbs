<link rel="stylesheet" href="/css/dashboard.css">

<div class="text-center">

  <p><b><h1>Sistema Integral de Información Institucional</h1></b></p>
  <p><b><h2>Universidad Tecnológica del Poniente</h2></b></p>

  <div class="header-dash text-center">
    <h2>¡Bienvenido, <span class="name-alumno">{{ nameAuth }}</span>!</h2>
    <p>Selecciona la opción que deseas consultar.</p>
  </div>
</div>


<div class="row pt-3">

{{#each items }}
  <div class="col-md-6 col-lg-4 d-flex align-items-stretch mb-5 mb-lg-0 justify-content-center card-dash">
    <div class="card w-75">
      <div class="icon-box animate-hover">
        <div class="text-center p-2">
          <img class="image" src={{ path_img }} alt="">
        </div>
        <div>
          <h4 class="title">{{ title }}</h4>
          <font class="sub-title">EXPEDIENTE</font>
        </div>
        <a class="information" href={{ link }}>
          <p>{{ content }}</p>
        </a>
      </div>
    </div>
  </div>
{{/each }}
</div>


<style>
  /* Estilos generales */
  body {
    font-family: 'Arial', sans-serif;
    background-color: #f8f9fa;
    padding: 10px;
    margin: 0;
  }

  /* Contenedor principal */
  .container {
    max-width: 100%;
    padding: 10px;
  }

  /* Títulos */
  h1,
  h5,
  h6 {
    color: #333;
    font-weight: bold;
    text-align: center;
  }

  /* Selector de evaluación */
  .form-select {
    font-size: 14px;
    padding: 6px;
  }

  /* Ajustes de la tabla */
  .table {
    font-size: 14px;
    width: 100%;
    margin: 0 auto;
    border-collapse: collapse;
  }

  /* Ajustes en móviles */
  @media (max-width: 768px) {
    h1 {
      font-size: 18px;
    }

    h5 {
      font-size: 14px;
    }

    h6 {
      font-size: 12px;
    }

    .btn {
      font-size: 12px;
      padding: 8px;
    }

    .table {
      font-size: 12px;
    }

    th,
    td {
      padding: 8px;
    }
  }

  /* Estilos para el spinner de carga */
  #loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    /* Ocupa toda la altura de la pantalla */
    background-color: rgba(255, 255, 255, 0.8);
    /* Fondo semitransparente */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999;
  }

  .spinner-border {
    width: 3rem;
    height: 3rem;
    border: 4px solid #f3f3f3;
    /* Color de fondo del spinner */
    border-top: 4px solid #007bff;
    /* Color del giro */
    border-radius: 50%;
    animation: spin 1s linear infinite;
    /* Animación de giro */
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  /* Estilo de los botones */
  .btn {
    font-size: 14px;
    border-radius: 0;
    /* Botones cuadrados */
    padding: 10px 20px;
    font-weight: bold;
    text-transform: uppercase;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    transition: background-color 0.3s, transform 0.3s;
  }

  /* Estilo del botón de regresar */
  .btn-custom-back {
    background-color: #911820;
    color: white;
    border: none;
  }

  .btn-custom-back:hover {
    background-color: #7a141a;
    transform: scale(1.05);
  }

  /* Estilo del botón de descargar flotante */
  .btn-custom-download {
    background-color: #911820;
    color: white;
    border: none;
    position: fixed;
    right: 20px;
    bottom: 20px;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 0;
    font-weight: bold;
    text-transform: uppercase;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    transition: background-color 0.3s, transform 0.3s;
  }

  .btn-custom-download:hover {
    background-color: #7a141a;
    transform: scale(1.05);
  }
</style>