<section class="section student-record">
  <div class="container-fluid">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
      <div>
        <h2 class="fw-bold mb-0 text-primary">
          <i class="bi bi-person-vcard me-2"></i>Registro Académico
        </h2>
      </div>
      <div>
        <button class="btn btn-primary" id="btn-habilitar">
          <i class="bi bi-pencil-square"></i> Editar Registro
        </button>
      </div>
    </div>

    <div class="row">
      <!-- Columna izquierda - Datos principales -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Ficha de Identificación</h5>
          </div>
          <div class="card-body">
            <div class="row mb-4">
              <div class="col-md-6">
                <div class="info-field">
                  <label class="text-muted small">Nombre completo</label>
                  <p class="fw-bold">{{NOMBRE}} {{PATERNO}} {{MATERNO}}</p>
                </div>
              </div>
              <div class="col-md-6">
                <div class="info-field">
                  <label class="text-muted small">CURP</label>
                  <p class="fw-bold text-uppercase">{{CLAVE_CIUDADANA}}</p>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-4">
                <div class="info-field">
                  <label class="text-muted small">Género</label>
                  <p>{{GENERO}}</p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="info-field">
                  <label class="text-muted small">Estado Civil</label>
                  <p>{{ESTADO_CIVIL}}</p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="info-field">
                  <label class="text-muted small">Lugar de Nacimiento</label>
                  <p>{{LUGAR_NACIMIENTO}}, {{ESTADO}}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sistema de pestañas -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-light">
            <ul class="nav nav-tabs card-header-tabs">
              <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#contacto-tab">
                  <i class="bi bi-house-door me-1"></i> Contacto
                </button>
              </li>
              <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#autorizada-tab">
                  <i class="bi bi-person-check me-1"></i> Contacto de Emergencia
                </button>
              </li>
              <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#seguro-tab">
                  <i class="bi bi-heart-pulse me-1"></i> Datos Médicos
                </button>
              </li>
              <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#ingles-tab">
                  <i class="bi bi-translate me-1"></i> Nivel de Inglés
                </button>
              </li>
            </ul>
          </div>
          <div class="card-body">
            <div class="tab-content">
              <!-- Pestaña de Contacto -->
              <div class="tab-pane fade show active" id="contacto-tab">
                <form method="post" action="/perfil/update-contacto">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Domicilio</label>
                      <input name="domicilio" class="form-control" value="{{DOMICILIO}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Estado</label>
                      <input name="estado" class="form-control" value="{{ESTADO}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Municipio</label>
                      <input name="entre_calles" class="form-control" value="{{ENTRE_CALLES}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Localidad</label>
                      <input name="ciudad" class="form-control" value="{{CIUDAD}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Código Postal</label>
                      <input name="cp" class="form-control" value="{{CP}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Email Personal</label>
                      <input name="email" type="email" class="form-control" value="{{EMAIL}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Email Institucional</label>
                      <input name="emailutp" type="email" class="form-control" value="{{EMAIL_ALTERNO}}"
                        placeholder="a.alumno@utponiente.edu.mx" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Teléfono</label>
                      <input name="telefono" class="form-control" value="{{TELEFONO}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Celular</label>
                      <input name="celular" class="form-control" value="{{CELULAR}}" disabled>
                    </div>
                  </div>
                  <div class="text-end mt-3 d-none">
                    <button type="submit" class="btn btn-primary" name="guardarForm">
                      <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                  </div>
                </form>
              </div>

              <!-- Pestaña de Persona Autorizada -->
              <div class="tab-pane fade" id="autorizada-tab">
                <form method="post" action="/perfil/update-per-contac">
                  <div class="row g-3">
                    <div class="col-md-12">
                      <label class="form-label">Nombre completo</label>
                      <input name="perContacto" class="form-control" value="{{CONTACTO}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Parentesco</label>
                      <select name="PARENTESCO_CONTACTO" class="form-select" disabled>
                        <option selected>{{PARENTESCO_CONTACTO}}</option>
                        <option value="PADRE">Padre</option>
                        <option value="MADRE">Madre</option>
                        <option value="HERMANO(A)">Hermano(a)</option>
                        <option value="ABUELO(A)">Abuelo(a)</option>
                        <option value="CONYUGUE">Cónyugue</option>
                        <option value="PARIENTE">Pariente</option>
                        <option value="AMIGO(A)">Amigo(a)</option>
                        <option value="OTRO(A)">Otro</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Teléfono</label>
                      <input name="telContacto" class="form-control" value="{{TEL_CONTACTO}}" disabled>
                    </div>
                  </div>
                  <div class="text-end mt-3 d-none">
                    <button type="submit" class="btn btn-primary" name="guardarForm">
                      <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                  </div>
                </form>
              </div>

              <!-- Pestaña de Seguro Médico -->
              <div class="tab-pane fade" id="seguro-tab">
                <form action="/perfil/update-seguro" method="post">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Tipo de seguro médico</label>
                      <select name="TIPO_SEG_MED" class="form-select" disabled>
                        <option selected>{{TIPO_SEG_MED}}</option>
                        <option value="Sin Especificar">Sin Especificar</option>
                        <option value="IMSS-UTP">IMSS-UTP</option>
                        <option value="IMSS-FAMILIAR">IMSS-FAMILIAR</option>
                        <option value="IMSS-LABORAL">IMSS-LABORAL</option>
                        <option value="IMSS-OPORTUNIDADES">IMSS-OPORTUNIDADES</option>
                        <option value="ISSTE">ISSTE</option>
                        <option value="PRIVADO">PRIVADO</option>
                        <option value="NO TIENE">NO TIENE</option>
                        <option value="SEGURO POPULAR">SEGURO POPULAR</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Número de seguro social</label>
                      <input name="nss" class="form-control" value="{{NUM_IMSS}}" disabled>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Número Verificador</label>
                      <input name="nss_verif" class="form-control" value="{{NUM_IMSS_VERIFICADOR}}" disabled>
                    </div>
                  </div>
                  <div class="text-end mt-3 d-none">
                    <button type="submit" class="btn btn-primary" name="guardarForm">
                      <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                  </div>
                </form>
              </div>

              <!-- Pestaña de Nivel de Inglés -->
              <div class="tab-pane fade" id="ingles-tab">
                <form method="post" action="/ingles/update-nivel">
                  <div class="row">
                    <div class="col-md-6">
                      <div class="info-field">
                        <label class="text-muted small">NIVEL DE INGLÉS TSU</label>
                        <p>{{PROYECTO_OBS}}</p>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-field">
                        <label class="text-muted small">NIVEL DE INGLÉS LIC</label>
                        <p>{{OBS_PROYECTO_LIC}}</p>
                      </div>
                    </div>
                  </div>
                  <div class="text-end mt-3 d-none">
                    <button type="submit" class="btn btn-primary" name="guardarForm">
                      <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha - Foto y datos secundarios -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body text-center">
            <div class="position-relative mb-3">
              <img src="{{image}}" alt="Foto del alumno" class="img-thumbnail rounded" width="200">
              <span
                class="position-absolute bottom-0 end-0 bg-success rounded-circle p-2 border border-3 border-white"></span>
            </div>
            <h4 class="mb-1">{{NOMBRE}} {{PATERNO}}</h4>
            <p class="text-muted mb-3">{{EMAIL}}</p>

            <div class="d-grid gap-2">

            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-header bg-light">
            <h6 class="mb-0"><i class="bi bi-info-circle me-1"></i> Información Adicional</h6>
          </div>
          <div class="card-body">
            <div class="info-field mb-3">
              <label class="text-muted small">Matrícula</label>
              <p>{{MATRICULA}}</p> <!-- Cambiado para usar variable MATRICULA -->
            </div>
            <div class="info-field mb-3">
              <label class="text-muted small">NIVEL</label>
              <p>{{NIVEL}}</p> <!-- Cambiado para usar variable -->
            </div>
            <div class="info-field">
              <label class="text-muted small">GRADO</label>
              <p>{{GRADO}}</p> <!-- Cambiado para usar variable -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .student-record {
    background-color: #f8f9fa;
  }

  .info-field {
    margin-bottom: 1rem;
  }

  .info-field label {
    display: block;
    font-size: 0.875rem;
  }

  .info-field p {
    margin-bottom: 0;
    font-size: 1rem;
  }

  .nav-tabs .nav-link {
    border: none;
    color: #495057;
    font-weight: 500;
  }

  .nav-tabs .nav-link.active {
    color: #0d6efd;
    border-bottom: 3px solid #0d6efd;
    background: transparent;
  }

  .card-header {
    border-bottom: 1px solid rgba(0, 0, 0, .125);
  }
</style>

<script src="/js/services/Perfil_Screen.js"></script>