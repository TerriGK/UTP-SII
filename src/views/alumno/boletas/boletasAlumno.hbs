<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boleta de Calificaciones</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
    }

    .logo-container {
      display: flex;
      align-items: center;
      margin-bottom: 10px;
    }

    .logo-container img {
      height: 60px;
      margin-right: 15px;
    }

    .periodo-container {
      text-align: right;
      font-weight: bold;
    }

    .report-title {
      color: navy;
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      margin: 0;
    }

    .student-info-table {
      margin-bottom: 0;
      border: 2px solid #000;
    }

    .student-info-table th {
      background-color: navy;
      color: white;
      text-align: center;
      padding: 8px;
    }

    .student-info-table td {
      padding: 8px;
      border: 1px solid #000;
    }

    .grades-table {
      width: 100%;
      border-collapse: collapse;
      border: 2px solid #000;
    }

    .grades-table th {
      background-color: navy;
      color: white;
      text-align: center;
      border: 1px solid #000;
      padding: 5px;
    }

    .grades-table td {
      border: 1px solid #000;
      padding: 5px;
    }

    .grades-table .numeric {
      text-align: center;
    }

    .grades-table tr:nth-child(even) {
      background-color: #f2f2f2;
    }

    .average-row {
      font-weight: bold;
    }

    .signature-section {
      margin-top: 30px;
      display: flex;
      justify-content: space-between;
    }

    .signature-box {
      text-align: center;
      width: 45%;
    }

    .signature-line {
      border-top: 1px solid #000;
      margin-top: 50px;
      padding-top: 5px;
    }

    .certification-text {
      font-size: 10px;
      text-align: right;
      font-style: italic;
    }

    .copy-footer {
      font-size: 10px;
      margin-top: 5px;
    }

    .seal-image {
      position: absolute;
      opacity: 0.2;
      width: 100px;
      left: 45%;
      margin-top: -20px;
    }

    .grade-pass {
      color: green;
      font-weight: bold;
    }

    .grade-fail {
      color: red;
      font-weight: bold;
    }
  </style>
</head>

<body>
  <section class="section profile">
    <div class="container">
      <!-- Header con botones de navegación -->
      <div class="my-4 d-flex justify-content-between align-items-center">
        {{>btnBack}}
        <button type="button" class="btn btn-success download-btn" onclick="generatePDF()">
          <i class="bi bi-cloud-arrow-down me-2"></i>
          Descargar boleta
        </button>
      </div>

      <!-- Tarjeta principal -->
      <div class="card main-card">
        <div class="card-header">
          <h1 class="card-title text-center mb-0">Calificaciones</h1>
        </div>

        <div class="card-body p-4">
          <!-- Logo y título -->
          <div class="d-flex justify-content-between mb-3">
            <div class="logo-container">
              <img src="/imgs/logorojo.jpg" alt="Logo UTP" class="img-fluid">
              <h2 class="report-title">BOLETA DE CALIFICACIONES</h2>
            </div>
            <div class="periodo-container">
              <p id="periodo-text"></p>
            </div>
          </div>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="doctos">
              <!-- Información del estudiante -->
              <div class="student-info mb-4">
                <div class="table-responsive">
                  <table class="table table-bordered student-table">
                    <thead class="table-light">
                      <tr>
                        <th scope="col">NOMBRE</th>
                        <th scope="col">MATRÍCULA</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="student-name">{{ NOMBRE }} {{PATERNO}} {{MATERNO}}</td>
                        <td class="student-id">{{ MATRICULA }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="filter-section p-3 mb-4">
                <div class="row g-3">
                  <div class="col-md-8">
                    <label for="cuatrimestre" class="form-label fw-bold">Selecciona el cuatrimestre:</label>
                    <select id="cuatrimestre" class="form-select custom-select" onchange="getCalifi()">
                      <option disabled selected>Elegir cuatrimestre</option>
                      <option value="1">Cuatrimestre 1</option>
                      <option value="2">Cuatrimestre 2</option>
                      <option value="3">Cuatrimestre 3</option>
                      <option value="4">Cuatrimestre 4</option>
                      <option value="5">Cuatrimestre 5</option>
                      <option value="6">Cuatrimestre 6</option>
                      <option value="7">Cuatrimestre 7</option>
                      <option value="8">Cuatrimestre 8</option>
                      <option value="9">Cuatrimestre 9</option>
                      <option value="10">Cuatrimestre 10</option>
                      <option value="11">Cuatrimestre 11</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label for="tipo_eval" class="form-label fw-bold">Tipo de evaluación:</label>
                    <select id="tipo_eval" class="form-select custom-select" onchange="getCalifi()">
                      <option value="A" selected>Ordinario</option>
                      <option value="B">% Asistencia</option>
                      <option value="E">Recuperativo</option>
                      <option value="G">Especial</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Tabla de calificaciones -->
              <div class="grades-table-container">
                <div class="table-responsive">
                  <table class="table table-hover grades-table">
                    <thead class="table-primary">
                      <tr>
                        <th scope="col" class="text-nowrap">Asignatura</th>
                        <th scope="col" class="text-center" width="150">Calificación</th>
                      </tr>
                    </thead>
                    <tbody id="table-content">
                      <!-- Contenido dinámico -->
                    </tbody>
                  </table>
                </div>

                <!-- Indicador de carga -->
                <div class="text-center py-4" id="loading" style="display: none;">
                  <div class="spinner-border text-primary"></div>
                  <p class="mt-2 text-muted">Cargando calificaciones...</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <input type="hidden" value="{{NUMEROALUMNO}}" id="numalumno">
  </section>

  <!-- Script para generar y descargar el PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="/js/services/alumno/getCalifiAlumno.js"></script>

  <script>
    // Función mejorada para formatear las calificaciones en la tabla (manteniendo la original)
    function formatGrades(data) {
      const tableContent = document.getElementById('table-content');
      tableContent.innerHTML = '';

      if (!data || data.length === 0) {
        const emptyRow = document.createElement('tr');
        emptyRow.innerHTML = `
        <td colspan="2" class="text-center py-4">
          <div class="alert alert-info mb-0">
            No hay calificaciones disponibles para el periodo seleccionado
          </div>
        </td>
      `;
        tableContent.appendChild(emptyRow);
        return;
      }

      data.forEach(item => {
        const row = document.createElement('tr');
        const grade = parseFloat(item.calificacion);
        const gradeClass = grade >= 7 ? 'grade-pass' : 'grade-fail';

        row.innerHTML = `
        <td>${item.asignatura}</td>
        <td class="text-center ${gradeClass}">${item.calificacion}</td>
      `;

        tableContent.appendChild(row);
      });

      // Agregar promedio si hay calificaciones
      if (data.length > 0) {
        const totalGrades = data.reduce((sum, item) => sum + parseFloat(item.calificacion), 0);
        const average = (totalGrades / data.length).toFixed(1);
        const averageClass = average >= 7 ? 'grade-pass' : 'grade-fail';

        const averageRow = document.createElement('tr');
        averageRow.classList.add('table-light');
        averageRow.innerHTML = `
        <td class="fw-bold">Promedio</td>
        <td class="text-center fw-bold ${averageClass}">${average}</td>
      `;

        tableContent.appendChild(averageRow);
      }
    }

    // Función para generar y descargar PDF
    function generatePDF() {
      const { jsPDF } = window.jspdf;

      // Mostrar indicador de carga
      const loadingEl = document.createElement('div');
      loadingEl.classList.add('pdf-loading');
      loadingEl.innerHTML = `
      <div class="loading-overlay">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">Generando PDF...</p>
      </div>
    `;
      document.body.appendChild(loadingEl);

      // Obtener elemento a convertir
      const element = document.querySelector('.main-card');

      // Obtener información del estudiante
      const studentName = document.querySelector('.student-name').textContent.trim();
      const studentId = document.querySelector('.student-id').textContent.trim();
      const cuatrimestre = document.getElementById('cuatrimestre');
      const cuatrimestreText = cuatrimestre.options[cuatrimestre.selectedIndex].text;
      const evaluacion = document.getElementById('tipo_eval');
      const evaluacionText = evaluacion.options[evaluacion.selectedIndex].text;

      // Crear nombre de archivo
      const fileName = `Boleta_${studentId}_${cuatrimestreText.replace(' ', '_')}.pdf`;

      // Generar PDF después de un pequeño retraso para permitir que se muestre el indicador de carga
      setTimeout(() => {
        html2canvas(element, {
          scale: 2,
          useCORS: true,
          logging: false
        }).then(canvas => {
          const imgData = canvas.toDataURL('image/png');
          const pdf = new jsPDF('p', 'mm', 'a4');

          // Agregar encabezado
          pdf.setFontSize(18);
          pdf.setTextColor(51, 51, 51);
          pdf.text('Universidad Tecnológica de Poniente', 105, 20, { align: 'center' });
          pdf.setFontSize(14);
          pdf.text('Sistema Integral de Información', 105, 30, { align: 'center' });

          // Agregar fecha
          pdf.setFontSize(10);
          pdf.setTextColor(102, 102, 102);
          const today = new Date();
          pdf.text(`Fecha de generación: ${today.toLocaleDateString()}`, 105, 40, { align: 'center' });

          // Calcular dimensiones
          const imgWidth = 170;
          const imgHeight = canvas.height * imgWidth / canvas.width;

          // Agregar imagen
          pdf.addImage(imgData, 'PNG', 20, 50, imgWidth, imgHeight);

          // Agregar pie de página
          pdf.setFontSize(8);
          pdf.setTextColor(128, 128, 128);
          pdf.text('Este documento es una representación digital de las calificaciones y no requiere firma.', 105, 285, { align: 'center' });

          // Descargar PDF
          pdf.save(fileName);

          // Eliminar indicador de carga
          document.body.removeChild(loadingEl);
        });
      }, 500);
    }

    // Estilo para el indicador de carga durante la generación del PDF
    document.head.insertAdjacentHTML('beforeend', `
    <style>
      .pdf-loading {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      
      .loading-overlay {
        background-color: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
      }
    </style>
  `);

    // Nota: Esto debe adaptarse a la implementación actual de getCalifi()
    const originalGetCalifi = window.getCalifi;
    window.getCalifi = function () {
      const loading = document.getElementById('loading');
      loading.style.display = 'block';

      // Asumiendo que la función original devuelve una promesa o usa un callback
      const result = originalGetCalifi();

      if (result && result.then) {
        result.then(data => {
          formatGrades(data);
          loading.style.display = 'none';
        }).catch(err => {
          console.error('Error al obtener calificaciones:', err);
          loading.style.display = 'none';
        });
      }

      return result;
    };
  </script>
</body>

</html>




<script>
  const periodoText = document.getElementById("periodo-text");
  const fecha = new Date();
  const anio = fecha.getFullYear();
  const mes = fecha.getMonth() + 1;

  let periodo = "";

  if (mes >= 1 && mes <= 4) {
    periodo = `Enero-Abril ${anio}`;
  } else if (mes >= 5 && mes <= 8) {
    periodo = `Mayo-Agosto ${anio}`;
  } else if (mes >= 9 && mes <= 12) {
    periodo = `Septiembre-Diciembre ${anio}`;
  }

  periodoText.innerHTML = `<strong>PERIODO:</strong><br>${periodo}`;
</script>