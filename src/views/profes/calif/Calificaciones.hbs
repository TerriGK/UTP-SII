  }

  /* Badge */
  .badge {
    font-weight: 400;
    padding: 5px 10px;
    font-size: 0.8rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .grades-container {
      padding: 0 10px;
    }
    
    .card-header, .card-body {
      padding: 15px;
    }
    
    .grades-table thead th, 
    .grades-table tbody td {
      padding: 10px;
      font-size: 0.9rem;
    }
    
    .btn-download-floating {
      bottom: 15px;
