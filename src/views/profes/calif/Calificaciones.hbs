<section class="grades-container">
  <input type="hidden" id="idprofesor" value="{{profe.CLAVEPROFESOR}}" />
  
  <!-- Card principal -->
  <div class="card grades-card">
    <!-- Cabecera con botones -->
    <div class="card-header d-flex justify-content-between align-items-center">
      <button type="button" class="btn btn-back" onclick="window.history.back()">
        <i class="bi bi-arrow-left"></i> Volver
      </button>
      <span class="badge text-bg-light">Cuatrimestre Actual</span>
    </div>

    <!-- Contenido principal -->
    <div class="card-body">
      <!-- Información del profesor -->
      <div class="professor-info text-center mb-4">
        <h2 class="card-title">Calificaciones</h2>
        <div class="professor-details">
          <p class="mb-1"><i class="bi bi-person-fill"></i> Prof. {{profe.NOMBREPROFESOR}}</p>
          <p class="mb-1 text-muted" id="asig">Asignatura: [Nombre]</p>
          <p class="mb-0 text-muted" id="grupo">Grupo: [Grupo]</p>
        </div>
      </div>

      <!-- Selector de evaluación -->
      <div class="evaluation-selector mb-4">
        <label for="idPlan" class="form-label small text-muted">EVALUACIÓN</label>
        <select id="idPlan" class="form-select">
          {{#each evals}}
            <option value="{{ID_EVAL}}">{{DESCRIPCION}}</option>
          {{/each}}
        </select>
      </div>

      <!-- Tabla de calificaciones -->
      <div class="table-responsive">
        <table class="table grades-table">
          <thead>
            <tr>
              <th width="5%">#</th>
              <th width="45%">Estudiante</th>
              <th width="25%">Matrícula</th>
              <th width="25%">Calificación</th>
            </tr>
          </thead>
          <tbody id="table-content">
            <!-- Datos se cargarán aquí -->
          </tbody>
        </table>
      </div>

      <!-- Spinner de carga -->
      <div id="loading" class="text-center my-4 d-none">
        <div class="spinner-border text-secondary" role="status"></div>
        <p class="text-muted mt-2">Cargando calificaciones...</p>
      </div>
    </div>

    <!-- Botón flotante de descarga -->
    <button onclick="descargarTablaExcel()" id="botonDescargarExcel" class="btn btn-download-floating">
      <i class="bi bi-download"></i> Excel
    </button>
  </div>
</section>

<!-- Scripts -->
<script src="/js/FileSaver.js"></script>
<script src="https://unpkg.com/xlsx/dist/xlsx.full.min.js"></script>
<script src="/js/services/profe/Exel_js/exportarExcel.js"></script>
<script src="/js/services/admin/GetCalificaciones/GetVercalificaciones_Profesor.js"></script>

<style>
