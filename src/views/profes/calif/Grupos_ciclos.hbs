<section class="assignment-container">
  <input type="hidden" id="idprofesor" value="{{CLAVEPROFESOR}}" />
  
  <div class="container py-4">
    <!-- Card principal -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <!-- Header con botón de regreso -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          {{>btnBack}}
          <span class="badge bg-light text-dark border">Profesores Grupo</span>
        </div>

        <!-- Título y profesor -->
        <div class="text-center mb-4">
          <h3 class="card-title fw-normal mb-2">Asignación de Grupos</h3>
          <p class="text-muted mb-0">
            <i class="bi bi-person-fill me-1"></i>
            Prof. {{NOMBREPROFESOR}}
          </p>
        </div>

        <!-- Barra de búsqueda minimalista -->
        <div class="mb-4">
          <div class="input-group border rounded">
            <span class="input-group-text bg-transparent border-0">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input type="search" 
                   class="form-control border-0" 
                   placeholder="Buscar materia o grupo..." 
                   id="buscar" />
          </div>
        </div>

        <!-- Tabla minimalista -->
        <div class="table-responsive">
          <table class="table table-borderless table-hover mb-0">
            <thead>
              <tr class="border-bottom">
                <th class="text-muted fw-normal small">#</th>
                <th class="text-muted fw-normal small">Código</th>
                <th class="text-muted fw-normal small">Materia</th>
                <th class="text-muted fw-normal small">Grupo</th>
                <th class="text-muted fw-normal small text-end">Acción</th>
              </tr>
            </thead>
            <tbody id="table-content" class="border-top-0">
              <!-- Datos dinámicos aquí -->
            </tbody>
          </table>
        </div>

        <!-- Paginación discreta -->
        <div class="d-flex justify-content-center mt-4">
          <nav>
            <ul class="pagination pagination-sm">
              <li class="page-item">
                <button class="page-link border-0 bg-transparent text-muted" onclick="onPrev()">
                  <i class="bi bi-chevron-left"></i>
                </button>
              </li>
              <li class="page-item">
                <button class="page-link border-0 bg-transparent text-muted" onclick="onNext()">
                  <i class="bi bi-chevron-right"></i>
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/services/profe/asignaciongrp.js"></script>


<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestor de Ciclos Académicos</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #3a86ff;
      --secondary-color: #6c757d;
      --success-color: #28a745;
      --danger-color: #dc3545;
      --light-bg: #f8f9fa;
      --border-radius: 8px;
      --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f5f5f5;
      color: #333;
      line-height: 1.6;
    }
    
    .container {
      max-width: 1200px;
      margin-top: 2rem;
    }
    
    .card {
      border: none;
      border-radius: var(--border-radius);
      box-shadow: var(--box-shadow);
      overflow: hidden;
      background-color: #ffffff;
    }
    
    .card-title {
      font-size: 1.4rem;
      font-weight: 500;
      color: #333;
      margin-bottom: 0.5rem;
    }
    
    .content-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    
    @media (max-width: 992px) {
      .content-container {
        grid-template-columns: 1fr;
      }
    }
    
    .cycles-section {
      background: white;
      border-radius: var(--border-radius);
      padding: 1.5rem;
      height: 100%;
    }
    
    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #eee;
    }
    
    .section-title h4 {
      color: var(--secondary-color);
      font-weight: 500;
      font-size: 1rem;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .badge-count {
      background-color: var(--primary-color);
      color: white;
      border-radius: 50%;
      width: 24px;
      height: 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      margin-left: 0.5rem;
    }
    
    .list-group {
      border-radius: var(--border-radius);
      border: 1px solid #eee;
    }
    
    .cycle-card {
      border-radius: var(--border-radius) !important;
      margin-bottom: 0.5rem;
      border: 1px solid rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease;
    }
    
    .cycle-card:hover {
      border-color: rgba(0, 0, 0, 0.1);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }
    
    .cycle-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .cycle-header h5 {
      font-weight: 500;
      color: #333;
      margin: 0;
      font-size: 0.95rem;
      flex-grow: 1;
    }
    
    .cycle-actions {
      display: flex;
      gap: 0.5rem;
    }
    
    .btn-toggle {
      border-radius: 20px;
      padding: 0.25rem 0.75rem;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s ease;
    }
    
    .btn-hide {
      background-color: var(--danger-color);
      color: white;
      border: none;
    }
    
    .btn-hide:hover {
      background-color: #c82333;
    }
    
    .btn-restore {
      background-color: var(--success-color);
      color: white;
      border: none;
    }
    
    .btn-restore:hover {
      background-color: #218838;
    }
    
    .cycle-list {
      margin-top: 0.75rem;
      padding-left: 0;
      list-style: none;
      font-size: 0.85rem;
    }
    
    .cycle-list li {
      margin-bottom: 0.25rem;
      color: #666;
    }
    
    .cycle-list li strong {
      color: #555;
      min-width: 60px;
      display: inline-block;
    }
    
    .notification {
      position: fixed;
      top: 20px;
      right: 20px;
      padding: 0.75rem 1.25rem;
      border-radius: var(--border-radius);
      color: white;
      box-shadow: var(--box-shadow);
      opacity: 0;
      transform: translateX(100%);
      transition: all 0.3s ease;
      z-index: 1000;
      font-size: 0.9rem;
    }
    
    .notification.show {
      opacity: 1;
      transform: translateX(0);
    }
    
    .notification.success {
      background-color: var(--success-color);
    }
    
    .notification.error {
      background-color: var(--danger-color);
    }
    
    .notification.warning {
      background-color: #ffc107;
    }
    
    .no-cycles-message {
      text-align: center;
      padding: 1.5rem;
      color: #6c757d;
      background-color: #f8f9fa;
      border-radius: var(--border-radius);
      margin-top: 0.5rem;
      font-size: 0.9rem;
    }
    
    .no-cycles-message i {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      display: block;
      color: #adb5bd;
    }
    
    .active-cycles {
      border-top: 3px solid var(--primary-color);
    }
    
    .hidden-cycles {
      border-top: 3px solid #6c757d;
    }
    
    .btn-outline-primary {
      border-color: var(--primary-color);
      color: var(--primary-color);
      font-size: 0.8rem;
    }
    
    .btn-outline-primary:hover {
      background-color: var(--primary-color);
      color: white;
    }
    
    .btn-outline-success {
      border-color: var(--success-color);
      color: var(--success-color);
      font-size: 0.8rem;
    }
    
    .btn-outline-success:hover {
      background-color: var(--success-color);
      color: white;
    }
    
    .form-check-input {
      margin-right: 0.5rem;
    }
    
    .selected-cycle {
      background-color: rgba(58, 134, 255, 0.05);
      border-left: 3px solid var(--primary-color) !important;
    }
  </style>


  
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="card-body p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="card-title mb-0">
            <i class="fas fa-calendar-alt me-2"></i>Gestor de Ciclos Académicos
          </h1>
          <span class="badge bg-light text-dark border">Administrador</span>
        </div>

        <!-- Notificación de Estado -->
        <div id="notification" class="notification"></div>

        <div class="content-container">
          <!-- Ciclos activos -->
          <div class="cycles-section active-cycles">
            <div class="section-title">
              <h4>
                <i class="fas fa-calendar-check"></i>
                Ciclos Activos
                <span id="activeCount" class="badge-count">0</span>
              </h4>
              <button id="selectAllActive" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-check-double"></i> Seleccionar
              </button>
            </div>
            
            <div id="emptyActiveCycles" class="no-cycles-message" style="display: none;">
              <i class="fas fa-calendar-times"></i>
              No hay ciclos activos disponibles
            </div>
            
            <ul class="list-group" id="cicloList">
              <!-- Los ciclos serán cargados dinámicamente aquí -->
            </ul>
          </div>

          <!-- Ciclos ocultos -->
          <div class="cycles-section hidden-cycles">
            <div class="section-title">
              <h4>
                <i class="fas fa-eye-slash"></i>
                Ciclos Ocultos
                <span id="hiddenCount" class="badge-count">0</span>
              </h4>
              <button id="restoreAllHidden" class="btn btn-sm btn-outline-success">
                <i class="fas fa-history"></i> Restaurar
              </button>
            </div>
            
            <div id="emptyHiddenCycles" class="no-cycles-message" style="display: none;">
              <i class="fas fa-check-circle"></i>
              No hay ciclos ocultos
            </div>
            
            <ul class="list-group" id="hiddenCyclesList">
              <!-- Los ciclos ocultos se mostrarán aquí -->
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    "use strict";

    // Elementos del DOM
    const elements = {
      cicloList: document.getElementById("cicloList"),
      hiddenCyclesList: document.getElementById("hiddenCyclesList"),
      notification: document.getElementById("notification"),
      activeCountBadge: document.getElementById("activeCount"),
      hiddenCountBadge: document.getElementById("hiddenCount"),
      selectAllActiveBtn: document.getElementById("selectAllActive"),
      restoreAllHiddenBtn: document.getElementById("restoreAllHidden"),
      emptyActiveCycles: document.getElementById("emptyActiveCycles"),
      emptyHiddenCycles: document.getElementById("emptyHiddenCycles")
    };

    // Arrays de ciclos
    let allCycles = [];
    let hiddenCycleIds = JSON.parse(localStorage.getItem("hiddenCycles") || "[]");
    let selectedCycleIds = JSON.parse(localStorage.getItem("selectedCycles") || []);

    // Notificación
    const notify = (message, type) => {
      const { notification } = elements;
      notification.textContent = message;
      notification.className = `notification ${type} show`;
      setTimeout(() => notification.className = "notification", 3000);
    };

    // Crear elemento checkbox
    const createCheckbox = (id, checked) => {
      const container = document.createElement("div");
      container.className = "form-check form-check-inline";
      
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.className = "form-check-input cycle-checkbox";
      checkbox.id = `cycle-${id}`;
      checkbox.checked = checked;
      
      checkbox.addEventListener("change", (e) => {
        toggleCycleSelection(id, e.target.checked);
      });
      
      container.appendChild(checkbox);
      return container;
    };

    // Crear botones de acción
    const createButton = (iconClass, text, btnClass, onClick) => {
      const button = document.createElement("button");
      button.className = `btn btn-sm btn-toggle ${btnClass}`;
      button.innerHTML = `<i class="${iconClass}"></i> ${text}`;
      button.addEventListener("click", onClick);
      return button;
    };

    // Crear elemento de ciclo
    const createCycleElement = (cycle, isHidden) => {
      const { CODIGO_CORTO, DESCRIPCION, INICIAL, FINAL, PERIODO } = cycle;

      const listItem = document.createElement("li");
      listItem.className = `list-group-item cycle-card ${isCycleSelected(CODIGO_CORTO) && !isHidden ? "selected-cycle" : ""}`;
      listItem.dataset.id = CODIGO_CORTO;

      const header = document.createElement("div");
      header.className = "cycle-header";

      // Checkbox solo para ciclos activos
      if (!isHidden) {
        header.appendChild(createCheckbox(CODIGO_CORTO, isCycleSelected(CODIGO_CORTO)));
      }

      const titulo = document.createElement("h5");
      titulo.textContent = `${DESCRIPCION} (${CODIGO_CORTO})`;
      
      if (!isHidden) {
        titulo.style.cursor = "pointer";
        titulo.addEventListener("click", () => {
          const checkbox = listItem.querySelector('.cycle-checkbox');
          checkbox.checked = !checkbox.checked;
          toggleCycleSelection(CODIGO_CORTO, checkbox.checked);
        });
      }

      const actions = document.createElement("div");
      actions.className = "cycle-actions";

      const button = isHidden
        ? createButton("fas fa-eye", "Mostrar", "btn-restore", () => restoreCycle(CODIGO_CORTO))
        : createButton("fas fa-eye-slash", "Ocultar", "btn-hide", () => hideCycle(CODIGO_CORTO));

      actions.appendChild(button);
      header.append(titulo, actions);

      const detailsList = document.createElement("ul");
      detailsList.className = "cycle-list";
      detailsList.innerHTML = `
        <li><strong>Inicial:</strong> ${INICIAL}</li>
        <li><strong>Final:</strong> ${FINAL}</li>
        <li><strong>Periodo:</strong> ${PERIODO}</li>
      `;

      listItem.append(header, detailsList);
      return listItem;
    };

    // Comprobar si un ciclo está seleccionado
    const isCycleSelected = (id) => {
      return selectedCycleIds.includes(id);
    };

    // Alternar selección de ciclo
    const toggleCycleSelection = (id, selected) => {
      if (selected && !selectedCycleIds.includes(id)) {
        selectedCycleIds.push(id);
      } else if (!selected) {
        selectedCycleIds = selectedCycleIds.filter(cycleId => cycleId !== id);
      }
      
      localStorage.setItem("selectedCycles", JSON.stringify(selectedCycleIds));
      updateCycleSelectionStyle(id, selected);
    };

    // Actualizar estilo de selección
    const updateCycleSelectionStyle = (id, selected) => {
      const cycleElement = document.querySelector(`li[data-id="${id}"]`);
      if (!cycleElement) return;
      
      if (selected) {
        cycleElement.classList.add("selected-cycle");
      } else {
        cycleElement.classList.remove("selected-cycle");
      }
      
      const checkbox = cycleElement.querySelector('.cycle-checkbox');
      if (checkbox) {
        checkbox.checked = selected;
      }
    };

    // Ocultar ciclo
    const hideCycle = (id) => {
      const cycle = allCycles.find(c => c.CODIGO_CORTO === id);
      if (!cycle) return;

      if (!hiddenCycleIds.includes(id)) {
        hiddenCycleIds.push(id);
        localStorage.setItem("hiddenCycles", JSON.stringify(hiddenCycleIds));
      }

      // Si el ciclo estaba seleccionado, quitarlo de la selección
      if (selectedCycleIds.includes(id)) {
        selectedCycleIds = selectedCycleIds.filter(cycleId => cycleId !== id);
        localStorage.setItem("selectedCycles", JSON.stringify(selectedCycleIds));
      }

      document.querySelector(`#cicloList li[data-id="${id}"]`)?.remove();
      elements.hiddenCyclesList.appendChild(createCycleElement(cycle, true));
      updateCounters();
      notify(`Ciclo "${cycle.DESCRIPCION}" ocultado`, "success");
    };

    // Restaurar ciclo
    const restoreCycle = (id) => {
      const cycle = allCycles.find(c => c.CODIGO_CORTO === id);
      if (!cycle) return;

      hiddenCycleIds = hiddenCycleIds.filter(cycleId => cycleId !== id);
      localStorage.setItem("hiddenCycles", JSON.stringify(hiddenCycleIds));

      document.querySelector(`#hiddenCyclesList li[data-id="${id}"]`)?.remove();
      elements.cicloList.appendChild(createCycleElement(cycle, false));
      updateCounters();
      notify(`Ciclo "${cycle.DESCRIPCION}" restaurado`, "success");
    };

    // Restaurar todos los ciclos
    const restoreAllCycles = () => {
      if (hiddenCycleIds.length === 0) {
        notify("No hay ciclos que restaurar", "warning");
        return;
      }
      
      hiddenCycleIds = [];
      localStorage.setItem("hiddenCycles", JSON.stringify(hiddenCycleIds));
      
      elements.hiddenCyclesList.innerHTML = "";
      
      allCycles.forEach(cycle => {
        if (hiddenCycleIds.includes(cycle.CODIGO_CORTO)) {
          elements.cicloList.appendChild(createCycleElement(cycle, false));
        }
      });
      
      updateCounters();
      notify("Todos los ciclos han sido restaurados", "success");
    };

    // Seleccionar todos los ciclos activos
    const selectAllActiveCycles = () => {
      const activeCycles = allCycles
        .filter(cycle => !hiddenCycleIds.includes(cycle.CODIGO_CORTO))
        .map(cycle => cycle.CODIGO_CORTO);
      
      if (activeCycles.length === 0) {
        notify("No hay ciclos activos para seleccionar", "warning");
        return;
      }
      
      const allSelected = activeCycles.every(id => selectedCycleIds.includes(id));
      
      if (allSelected) {
        selectedCycleIds = [];
        notify("Se han deseleccionado todos los ciclos", "success");
      } else {
        selectedCycleIds = activeCycles;
        notify("Se han seleccionado todos los ciclos activos", "success");
      }
      
      localStorage.setItem("selectedCycles", JSON.stringify(selectedCycleIds));
      
      document.querySelectorAll('#cicloList li').forEach(cycleElement => {
        const id = cycleElement.dataset.id;
        const selected = selectedCycleIds.includes(id);
        updateCycleSelectionStyle(id, selected);
      });
      
      elements.selectAllActiveBtn.innerHTML = allSelected
        ? '<i class="fas fa-check-double"></i> Seleccionar'
        : '<i class="fas fa-times"></i> Deseleccionar';
    };

    // Actualizar contadores
    const updateCounters = () => {
      const activeCount = elements.cicloList.querySelectorAll('li').length;
      const hiddenCount = elements.hiddenCyclesList.querySelectorAll('li').length;
      
      elements.activeCountBadge.textContent = activeCount;
      elements.hiddenCountBadge.textContent = hiddenCount;
      
      elements.emptyActiveCycles.style.display = activeCount === 0 ? 'block' : 'none';
      elements.emptyHiddenCycles.style.display = hiddenCount === 0 ? 'block' : 'none';
    };

    // Cargar ciclos
    const cargarCiclosLista = async () => {
      try {
        const response = await fetch("/api/cuatris-navbar");
        if (!response.ok) throw new Error(`Error al obtener ciclos: ${response.status}`);
        const { ciclos = [] } = await response.json();

        // Filtrar y ordenar ciclos
        allCycles = ciclos
          .filter(cycle => cycle.PERIODO > 0)
          .sort((a, b) => b.CODIGO_CORTO.localeCompare(a.CODIGO_CORTO));

        elements.cicloList.innerHTML = "";
        elements.hiddenCyclesList.innerHTML = "";

        allCycles.forEach(cycle => {
          const isHidden = hiddenCycleIds.includes(cycle.CODIGO_CORTO);
          const cycleElement = createCycleElement(cycle, isHidden);
          (isHidden ? elements.hiddenCyclesList : elements.cicloList).appendChild(cycleElement);
        });

        updateCounters();
      } catch (error) {
        console.error("Error al cargar los ciclos:", error);
        notify("No se pudieron cargar los ciclos. Intente nuevamente más tarde.", "error");
      }
    };

    // Event listeners
    elements.selectAllActiveBtn.addEventListener("click", selectAllActiveCycles);
    elements.restoreAllHiddenBtn.addEventListener("click", restoreAllCycles);

    // Inicializar
    document.addEventListener("DOMContentLoaded", cargarCiclosLista);
  </script>
</body>
</html>





