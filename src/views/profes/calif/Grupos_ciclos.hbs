<section class="assignment-container">
  <input type="hidden" id="idprofesor" value="{{CLAVEPROFESOR}}" />
  
  <div class="container py-4">
    <!-- Card principal -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <!-- Header con botón de regreso -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          {{>btnBack}}
          <span class="badge bg-light text-dark border">{{NOMBREPROFESOR}}</span>
        </div>

        <!-- Título y profesor -->
        <div class="text-center mb-4">
          <h3 class="card-title fw-normal mb-2">Asignación de Grupos</h3>
          <p class="text-muted mb-0">
            <i class="bi bi-person-fill me-1"></i>
            Prof. {{NOMBREPROFESOR}}
          </p>
        </div>

        <!-- Barra de búsqueda minimalista -->
        <div class="mb-4">
          <div class="input-group border rounded">
            <span class="input-group-text bg-transparent border-0">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input type="search" 
                   class="form-control border-0" 
                   placeholder="Buscar materia o grupo..." 
                   id="buscar" />
          </div>
        </div>

        <!-- Tabla minimalista -->
        <div class="table-responsive">
          <table class="table table-borderless table-hover mb-0">
            <thead>
              <tr class="border-bottom">
                <th class="text-muted fw-normal small">#</th>
                <th class="text-muted fw-normal small">Código</th>
                <th class="text-muted fw-normal small">Materia</th>
                <th class="text-muted fw-normal small">Grupo</th>
                <th class="text-muted fw-normal small text-end">Acción</th>
              </tr>
            </thead>
            <tbody id="table-content" class="border-top-0">
              <!-- Datos dinámicos aquí -->
            </tbody>
          </table>
        </div>

        <!-- Paginación discreta -->
        <div class="d-flex justify-content-center mt-4">
          <nav>
            <ul class="pagination pagination-sm">
              <li class="page-item">
                <button class="page-link border-0 bg-transparent text-muted" onclick="onPrev()">
                  <i class="bi bi-chevron-left"></i>
                </button>
              </li>
              <li class="page-item">
                <button class="page-link border-0 bg-transparent text-muted" onclick="onNext()">
                  <i class="bi bi-chevron-right"></i>
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/services/profe/asignaciongrp.js"></script>